<?xml version="1.0" encoding="utf-8"?>
<policyDefinitions revision="1.0" schemaVersion="1.0"
                 xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <policyNamespaces>
    <target prefix="ConfigHub" namespace="ConfigHub"/>
    <using prefix="windows" namespace="Microsoft.Policies.Windows"/>
  </policyNamespaces>
  <resources minRequiredRevision="1.0" fallbackCulture="en-US"/>
  <categories>
    <category name="ConfigHub" displayName="ConfigHub">
      <category name="BIOS" displayName="BIOS Settings">        <policy name="--ThermalManagement" displayName="--ThermalManagement" explainText="ThermalManagement cools the fan and the processor to improve the system performance by reducing noise and temperature." key="SOFTWARE\Microsoft\Policies\ConfigHub\BIOS\--ThermalManagement" class="Machine">
          <parentCategory ref="ConfigHub_BIOS"/>
          <supportedOn ref="windows:SUPPORTED_Windows_10_0_NOARM"/>
          <elements>
            <enum id="--ThermalManagement_Argument" valueName="Argument" default="Not Configured">              <item name="Optimized">
                <value><name>Optimized</name><value>Optimized</value></value>
              </item>              <item name="Cool">
                <value><name>Cool</name><value>Cool</value></value>
              </item>              <item name="Quiet">
                <value><name>Quiet</name><value>Quiet</value></value>
              </item>              <item name="UltraPerformance">
                <value><name>UltraPerformance</name><value>UltraPerformance</value></value>
              </item>              <item name="Not Configured">
                <value><name>Not Configured</name><value>Not Configured</value></value>
              </item>            </enum>
          </elements>
        </policy>        <policy name="--NumLock" displayName="--NumLock" explainText="Enables or disables the keyboard number lock." key="SOFTWARE\Microsoft\Policies\ConfigHub\BIOS\--NumLock" class="Machine">
          <parentCategory ref="ConfigHub_BIOS"/>
          <supportedOn ref="windows:SUPPORTED_Windows_10_0_NOARM"/>
          <elements>
            <enum id="--NumLock_Argument" valueName="Argument" default="Not Configured">              <item name="Enabled">
                <value><name>Enabled</name><value>Enabled</value></value>
              </item>              <item name="Disabled">
                <value><name>Disabled</name><value>Disabled</value></value>
              </item>              <item name="Not Configured">
                <value><name>Not Configured</name><value>Not Configured</value></value>
              </item>            </enum>
          </elements>
        </policy>      </category>
